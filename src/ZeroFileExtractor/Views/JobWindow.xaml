<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZeroFileExtractor.Views.JobWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zero File Extractor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="36,*" ActualThemeChanged="RootGrid_ActualThemeChanged">

        <!-- Başlık çubuğu -->
        <Grid x:Name="AppTitleBar" Padding="14,0,0,0" ColumnSpacing="10" ColumnDefinitions="Auto,*">
            <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="Zero File Extractor" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- 1) Seçenekler -->
        <Grid x:Name="SetupPage" Grid.Row="1" RowDefinitions="Auto,*,Auto" Padding="20,4,20,16" Visibility="Collapsed">
            <TextBlock x:Name="SetupTitle" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,6" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <ContentPresenter x:Name="SetupHost" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button x:Name="StartButton" Content="Başlat" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                <Button Content="Vazgeç" MinWidth="90" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- 2) İlerleme -->
        <Grid x:Name="ProgressPage" Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6" Padding="20,6,20,16" Visibility="Collapsed">
            <TextBlock x:Name="JobTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CurrentItem" Grid.Row="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar x:Name="Bar" Grid.Row="2" Maximum="1000" Margin="0,8,0,2" />
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ProgressText" />
                <TextBlock x:Name="PercentText" Grid.Column="1" FontWeight="SemiBold" />
            </Grid>
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SpeedText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="RemainingText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TextBlock x:Name="QueueText" Grid.Row="5" VerticalAlignment="Top" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <CheckBox x:Name="CloseWhenDone" Content="Bitince pencereyi kapat" Click="CloseWhenDone_Click" />
                <Button x:Name="PauseButton" Grid.Column="1" Content="Duraklat" MinWidth="100" Click="Pause_Click" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="İptal" MinWidth="90" Click="Cancel_Click" />
            </Grid>
        </Grid>

        <!-- 3) Sonuç -->
        <Grid x:Name="DonePage" Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="10" Padding="20,6,20,16" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon x:Name="DoneIcon" FontSize="28" Glyph="&#xE930;" />
                <TextBlock x:Name="DoneTitle" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DoneText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="OpenArchiveButton" Content="Arşivi aç" Visibility="Collapsed" Click="OpenArchive_Click" />
                <Button x:Name="OpenFolderButton" Content="Klasörü aç" Visibility="Collapsed" Click="OpenFolder_Click" />
                <Button Content="Kapat" MinWidth="90" Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
